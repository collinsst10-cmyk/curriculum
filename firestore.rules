rules_version = '2';
// 초등 교육과정 편성 도우미 - Cloud Firestore 보안 규칙
//  - admins/{email}   : 관리자. Firebase 콘솔에서만 추가(앱에서는 쓰기 불가)
//  - allowed/{email}  : 관리자가 승인한 사용자
//  - requests/{email} : 본인이 올리는 사용 승인 요청
//  - plans/{id}       : 승인된 사용자 중 소유자와 소유자가 초대한 이메일(editors)만 읽고 고침
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isDeveloper() {
      let roles = /databases/$(database)/documents/config/roles;
      return isAdmin() && exists(roles) && myEmail() in get(roles).data.get('developers', []);
    }
    function recentlyAuthenticated() {
      return request.auth.token.auth_time * 1000 >= request.time.toMillis() - 600000;
    }
    function isApproved() {
      return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/allowed/$(myEmail())));
    }
    // 교내 교직원(승인 때 '일반 사용자'로 정하지 않은 사람). 일반 사용자는 공개 정보(학사일정·학교 정보·사진)만
    function isStaff() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/allowed/$(myEmail()))
        && get(/databases/$(database)/documents/allowed/$(myEmail())).data.get('userType', 'staff') != 'general');
    }
    function isOwner(d) {
      return d.ownerUid == request.auth.uid;
    }
    // 목록 조회(array-contains)가 규칙으로 증명되도록 토큰 이메일을 그대로 비교
    function isEditor(d) {
      return request.auth.token.email in d.editors;
    }
    function validPlan(d) {
      return d.keys().hasAll(['ownerUid', 'ownerEmail', 'editors', 'title', 'year', 'stateJson'])
        && d.editors is list && d.editors.size() <= 50
        && d.stateJson is string && d.stateJson.size() < 900000;
    }

    match /admins/{email} {
      allow read: if signedIn() && myEmail() == email;
      allow write: if false;
    }

    match /allowed/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin());
      allow write: if isAdmin();   // 이름은 등록 신청 때 정해지고, 이후 변경은 관리자만
    }

    match /requests/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin());
      allow create: if signedIn() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'kind', 'grade', 'subj', 'memo', 'requestedAt'])
        && request.resource.data.email == email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && (!('role' in request.resource.data) || (request.resource.data.role is string && request.resource.data.role.size() <= 40))
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['homeroom', 'subject', 'special', 'staff', 'other'])
        && (!('grade' in request.resource.data) || (request.resource.data.grade is string && request.resource.data.grade.size() <= 2))
        && (!('subj' in request.resource.data) || (request.resource.data.subj is string && request.resource.data.subj.size() <= 20))
        && (!('memo' in request.resource.data) || (request.resource.data.memo is string && request.resource.data.memo.size() <= 100));
      allow delete: if isAdmin() || (signedIn() && myEmail() == email);
      allow update: if false;
    }

    match /plans/{planId} {
      allow read: if isStaff() && (isOwner(resource.data) || isEditor(resource.data));

      allow create: if isStaff()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && validPlan(request.resource.data);

      allow update: if isStaff() && validPlan(request.resource.data) && (
        isOwner(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid
        || isEditor(resource.data)
           && request.resource.data.ownerUid == resource.data.ownerUid
           && request.resource.data.ownerEmail == resource.data.ownerEmail
           && request.resource.data.editors == resource.data.editors
      );

      allow delete: if isStaff() && isOwner(resource.data);
    }

    // 교육활동 일정(날짜별 1문서). 승인된 교직원 공용. 겹침 검사는 앱의 트랜잭션이 담당
    match /activityDays/{day} {
      allow read: if isApproved();
      allow create, update: if isStaff() && hasOperatingDateYear(request.resource.data, day)
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      allow delete: if isAdmin();
    }

    // 학교 공용 학사일정 (학년도별 1문서). 승인된 선생님은 읽기, 관리자만 수정
    match /calendar/{year} {
      allow read: if isApproved();
      allow write: if isAdmin() && year.matches('^[0-9]{4}$');
    }

    // 선생님들께 게시한 학교 교육과정(조회 전용). 승인된 선생님은 읽기, 관리자만 게시
    match /published/{doc} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // 학교 정보(학교명·학년도·학급 수). 선생님 화면이 이 값을 씀. 관리자만 수정
    match /schoolPrivate/neis {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 10
        && (isDeveloper() || recentlyAuthenticated() || (request.method == 'create'
          && get(/databases/$(database)/documents/config/school).data.get('neis', null) == request.resource.data.code));
    }

    match /config/school {
      allow read: if isApproved() && (isStaff() || !resource.data.keys().hasAny(['neis']));
      allow create: if isAdmin() && (isDeveloper() || recentlyAuthenticated())
        && !request.resource.data.keys().hasAny(['neis'])
        && request.resource.data.year is int && request.resource.data.year >= 2000 && request.resource.data.year <= 2099;
      allow update: if isAdmin() && (
        isDeveloper() || recentlyAuthenticated()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bell', 'updatedAt', 'updatedBy'])
        || (resource.data.keys().hasAny(['neis']) && !request.resource.data.keys().hasAny(['neis'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['neis'])
          && existsAfter(/databases/$(database)/documents/schoolPrivate/neis))
      ) && (!request.resource.data.keys().hasAny(['neis'])
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['neis'])) && request.resource.data.year is int && request.resource.data.year >= 2000 && request.resource.data.year <= 2099;
    }

    match /schoolYears/{year} {
      allow read: if isApproved();
      allow create, update: if isAdmin() && (isDeveloper() || recentlyAuthenticated()
        || (request.method == 'update' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bell', 'updatedAt', 'updatedBy'])))
        && request.resource.data.year is int && string(request.resource.data.year) == year;
    }

    // 이전 자료는 원본을 보존하고 승인된 데이터 이전에만 사용한다.
    match /kclassOwners/{classId} {
      allow get: if isAdmin();
    }
    match /kclassTimetables/{classId} {
      allow get: if isAdmin();
    }
    function isKclassStaff() {
      return isYearKclassStaff(activeRosterYear());
    }

    // 직위(allowed 문서의 posType·posCls·head). 관리자가 사용자 승인 관리에서 정함
    function myAllowed() {
      return get(/databases/$(database)/documents/allowed/$(myEmail())).data;
    }
    function hasAllowed() {
      return exists(/databases/$(database)/documents/allowed/$(myEmail()));
    }
    // 학교 일지 작성자: 지정된 작성자 또는 직위가 교무부장인 선생님
    function isLogWriter() {
      return isStaff() && (
        (exists(/databases/$(database)/documents/config/roles)
          && myEmail() in get(/databases/$(database)/documents/config/roles).data.get('logWriters', []))
        || (hasAllowed() && myAllowed().get('head', '') == '교무부장'));
    }

    // 학교 현황(학생·교직원). 승인된 선생님은 읽기(HOME), 관리자 수정 (교무부장은 전입·전출 반영 때 수정)
    match /config/stats {
      allow read: if isStaff();
      allow write: if isAdmin() || isLogWriter();
    }
    // 이주배경학생 현황. 관리자와 한국어학급 담당이 수정
    match /config/migrant {
      allow read: if isStaff();
      allow write: if (isAdmin() || isKclassStaff())
        && request.resource.data.keys().hasOnly(['asOf', 'foreign', 'domestic', 'midEntry', 'nonMigrant', 'countries', 'note', 'updatedBy', 'updatedAt'])
        && request.resource.data.countries is string && request.resource.data.countries.size() <= 600;
    }
    // 역할 지정(교무부장 = 일지 작성자). 관리자만
    match /config/roles {
      allow read: if isStaff();
      allow create: if isAdmin() && !('developers' in request.resource.data);
      allow update: if isAdmin() && (
        isDeveloper() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['developers'])
      );
      allow delete: if isDeveloper();
    }

    // 학생 전입·전출(학생 이름 없음). 승인된 선생님은 읽기(HOME 알림), 관리자·교무부장이 등록·삭제
    match /transfers/{id} {
      allow read: if isStaff();
      allow create: if (isAdmin() || isLogWriter())
        && request.resource.data.keys().hasOnly(['date', 'type', 'grade', 'cls', 'sex', 'note', 'applied', 'by', 'byName', 'createdAt', 'year'])
        && request.resource.data.date is string && hasOperatingDateYear(request.resource.data, request.resource.data.date)
        && request.resource.data.type in ['in', 'out'] && request.resource.data.sex in ['m', 'f']
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 100;
      allow delete: if (isAdmin() || isLogWriter()) && isOperatingDate(resource.data.date)
        && !existsAfter(/databases/$(database)/documents/rosterTransferLinks/$(id));
      allow update: if false;
    }

    // 그 반 담임: 본인이 고른 학급(homerooms) 또는 관리자가 정한 직위(담임 학급)
    function isHomeroomOf(g, c) {
      return isStaff() && (
        (exists(/databases/$(database)/documents/homerooms/$(myEmail()))
          && get(/databases/$(database)/documents/homerooms/$(myEmail())).data.grade == g
          && get(/databases/$(database)/documents/homerooms/$(myEmail())).data.cls == c)
        || (hasAllowed() && myAllowed().get('posType', '') == 'homeroom'
          && myAllowed().get('posCls', '') == string(g) + '-' + string(c)));
    }
    match /homerooms/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin());
      allow write: if isStaff() && myEmail() == email
        && request.resource.data.keys().hasOnly(['grade', 'cls', 'name', 'updatedAt'])
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 20;
    }
    // 구형 명단과 행동 기록은 이전 및 검증을 위한 관리자 조회만 허용한다.
    match /students/{id} {
      allow read: if isAdmin();
    }
    function canAccessBehavior(studentId) {
      return isAdmin() && exists(/databases/$(database)/documents/students/$(studentId));
    }
    match /students/{studentId}/privateRecords/behavior {
      allow get: if canAccessBehavior(studentId);
    }
    // 학년도 미확인 원본은 관리자에게만 읽기 허용한다.
    match /migrantStudents/{id} {
      allow read: if isAdmin();
    }
    match /migrantClassSum/{key} {
      allow read: if isAdmin();
    }

    match /heroPhotos/{id} {
      allow read: if isApproved();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'order', 'createdAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }
    // 홈페이지 설정(사진 바뀌는 간격 등). 관리자만 수정
    match /shoppingSites/{view} {
      allow get: if (view == 'catalog' && isAdmin()) || (view == 'active' && isStaff());
      allow create, update: if view in ['catalog', 'active'] && isAdmin()
        && request.resource.data.keys().hasOnly(['sites'])
        && request.resource.data.sites is list && request.resource.data.sites.size() <= 30;
    }

    match /config/site {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // 한국어학급 연계(담당 교사·조정 기록)
    match /config/ksl {
      allow read, write: if isStaff();
    }

    // 학교운영일지(날짜별 1문서). 승인된 선생님은 읽기, 직위가 교무부장인 선생님(과 개발자)만 작성
    function isHeadAffairs() {
      return isStaff() && hasAllowed() && myAllowed().get('head', '') == '교무부장';
    }
    match /dailyLogs/{day} {
      allow read: if isStaff();
      allow create, update: if (isHeadAffairs() || isDeveloper()) && hasOperatingDateYear(request.resource.data, day)
        && (resource == null || resource.data.get('year', request.resource.data.year) == request.resource.data.year);
      allow delete: if (isHeadAffairs() || isDeveloper()) && isOperatingDate(day);
    }

    function isOperatingDate(date) {
      let year = get(/databases/$(database)/documents/config/school).data.year;
      let cal = /databases/$(database)/documents/calendar/$(string(year));
      let period = exists(cal) ? get(cal).data.get('operatingPeriod', {}) : {};
      let start = period.get('start', string(year) + '-03-01');
      let end = period.get('end', string(year + 1) + '-03-01');
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && date >= start && date < end;
    }
    function hasOperatingDateYear(d, date) {
      return isOperatingDate(date) && string(d.year) == activeRosterYear();
    }
    match /yearStats/{year} {
      allow read: if isStaff();
      allow create, update: if (isAdmin() || isLogWriter()) && year == activeRosterYear();
    }

    // 그 밖의 모든 경로는 차단
    function activeRosterYear() {
      return string(get(/databases/$(database)/documents/config/school).data.year);
    }
    function rosterAssignment(year) {
      return /databases/$(database)/documents/rosterYears/$(year)/homerooms/$(myEmail());
    }
    function staffAccount(email) {
      return /databases/$(database)/documents/staffAccounts/$(email);
    }
    function staffClass(year, classId) {
      return /databases/$(database)/documents/staffYears/$(year)/classOwners/$(classId);
    }
    function managesStaffClass(year, classId) {
      return exists(staffClass(year, classId));
    }
    function hasStaffClassAssignment(year, classId) {
      return exists(staffAccount(myEmail()))
        && get(staffClass(year, classId)).data.staffId == get(staffAccount(myEmail())).data.staffId;
    }
    function hasManagedHomeroom(year) {
      let account = staffAccount(myEmail());
      return exists(account) && exists(/databases/$(database)/documents/staffYears/$(year)/ownHomerooms/$(get(account).data.staffId));
    }
    function isYearHomeroom(year, classId) {
      return isStaff() && year == activeRosterYear()
        && (managesStaffClass(year, classId) ? hasStaffClassAssignment(year, classId)
          : (!hasManagedHomeroom(year) && exists(rosterAssignment(year)) && get(rosterAssignment(year)).data.classId == classId));
    }
    match /staffProfiles/{staffId} {
      allow read, create, update: if isAdmin();
    }
    match /staffNames/{staffId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
    }
    match /staffAccounts/{email} {
      allow get: if isAdmin() || (isStaff() && myEmail() == email);
      allow list, create, update, delete: if isAdmin();
    }
    match /staffYears/{year} {
      allow read, create, update: if isAdmin();
      match /classOwners/{classId} {
        allow read, create, update: if isAdmin();
      }
      match /ownHomerooms/{staffId} {
        allow get: if isAdmin() || (isStaff() && year == activeRosterYear()
          && exists(staffAccount(myEmail())) && get(staffAccount(myEmail())).data.staffId == staffId);
        allow create, update, delete: if isAdmin();
      }
    }
    match /staffSchedule/{year} {
      allow get: if isAdmin() || (isStaff() && year == activeRosterYear());
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['subjects', 'activeCount', 'activeStaffIds'])
        && request.resource.data.subjects is list && request.resource.data.subjects.size() <= 200
        && request.resource.data.activeCount is int && request.resource.data.activeCount >= 0
        && request.resource.data.get('activeStaffIds', []) is list && request.resource.data.get('activeStaffIds', []).size() <= 500;
    }
    match /rosterYears/{year}/homerooms/{email} {
      allow get: if isAdmin() || (isStaff() && email == myEmail() && year == activeRosterYear());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['classId'])
        && request.resource.data.classId.matches('^[1-6]-([1-9]|1[0-9]|20)$');
      allow delete: if isAdmin();
    }
    function yearMember(year, studentId) {
      return /databases/$(database)/documents/rosterYears/$(year)/memberships/$(studentId);
    }
    function yearClass(year, classId) {
      return /databases/$(database)/documents/rosterYears/$(year)/classes/$(classId);
    }
    function studentProfile(studentId) {
      return /databases/$(database)/documents/studentProfiles/$(studentId);
    }
    function canWriteYearProfile(studentId) {
      let year = activeRosterYear();
      let member = getAfter(yearMember(year, studentId)).data;
      return isYearHomeroom(year, member.classId) && member.status == 'enrolled'
        && member.displayName == request.resource.data.name && member.sex == request.resource.data.sex;
    }
    match /studentProfiles/{studentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (canWriteYearProfile(studentId)
        && request.resource.data.keys().hasOnly(['name', 'sex', 'createdAt']));
      allow update: if isAdmin() || (canWriteYearProfile(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sex']));
    }
    match /rosterYears/{year}/classes/{classId} {
      allow get: if isAdmin() || isYearHomeroom(year, classId);
      allow list: if isAdmin();
      allow create, update: if request.resource.data.year == year && (isAdmin()
        || (isYearHomeroom(year, classId)
          && request.resource.data.keys().hasOnly(['year', 'grade', 'cls', 'slots'])
          && request.resource.data.slots is map
          && request.resource.data.slots.size() <= 99
          && classId == string(request.resource.data.grade) + '-' + string(request.resource.data.cls)));
    }
    match /rosterYears/{year}/memberships/{studentId} {
      allow delete: if isAdmin() && resource.data.get('transferId', '') != '';
      allow read: if isAdmin() || isYearHomeroom(year, resource.data.classId);
      allow create, update: if (isAdmin() || (
          isYearHomeroom(year, request.resource.data.classId)
          && (resource == null ? (!exists(studentProfile(studentId)) && !request.resource.data.keys().hasAny(['legacyId', 'transferId']))
            : (resource.data.classId == request.resource.data.classId && resource.data.status == 'enrolled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['no', 'displayName', 'sex', 'mig', 'country', 'note', 'status', 'updatedAt', 'updatedBy'])))
          && request.resource.data.status in ['enrolled', 'transferred']
          && ((resource != null && resource.data.displayName == request.resource.data.displayName)
            || getAfter(studentProfile(studentId)).data.name == request.resource.data.displayName)
          && getAfter(yearClass(year, request.resource.data.classId)).data.slots.get(string(request.resource.data.no), '') ==
            (request.resource.data.status == 'enrolled' ? studentId : '')
        ))
        && request.resource.data.year == year
        && request.resource.data.studentId == studentId
        && request.resource.data.keys().hasOnly(['year', 'studentId', 'grade', 'cls', 'classId', 'no',
          'status', 'displayName', 'sex', 'mig', 'country', 'note', 'legacyId', 'transferId', 'updatedAt', 'updatedBy'])
        && request.resource.data.classId == string(request.resource.data.grade) + '-' + string(request.resource.data.cls)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 20
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 20
        && request.resource.data.no is int && request.resource.data.no >= 1 && request.resource.data.no <= 99
        && request.resource.data.status in ['enrolled', 'transferred', 'graduated', 'deferred'];
    }

    function validYearBehavior(d) {
      return d.keys().hasOnly(['studentId', 'membershipId', 'year', 'grade', 'cls', 'no', 'classId', 'traits', 'opinion', 'target'])
        && d.get('traits', {}) is map && d.get('traits', {}).size() <= 100
        && d.get('opinion', '') is string && d.get('opinion', '').size() <= 4000
        && d.get('target', 300) is int && d.get('target', 300) >= 1 && d.get('target', 300) <= 2000;
    }
    function canEditYearBehavior(year, studentId) {
      let member = get(yearMember(year, studentId)).data;
      return isAdmin() || (member.status == 'enrolled' && isYearHomeroom(year, member.classId));
    }
    match /rosterYears/{year}/behavior/{studentId} {
      allow get: if canEditYearBehavior(year, studentId)
        && (resource == null || isAdmin() || isYearHomeroom(year, resource.data.classId));
      allow create: if canEditYearBehavior(year, studentId)
        && validYearBehavior(request.resource.data)
        && request.resource.data.year == year && request.resource.data.studentId == studentId
        && request.resource.data.membershipId == studentId
        && request.resource.data.grade == get(yearMember(year, studentId)).data.grade
        && request.resource.data.cls == get(yearMember(year, studentId)).data.cls
        && request.resource.data.no == get(yearMember(year, studentId)).data.no
        && request.resource.data.classId == get(yearMember(year, studentId)).data.classId;
      allow update: if canEditYearBehavior(year, studentId)
        && (isAdmin() || isYearHomeroom(year, resource.data.classId))
        && validYearBehavior(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['traits', 'opinion', 'target']);
    }
    function ownsYearKclass(year, classId) {
      let owner = /databases/$(database)/documents/rosterYears/$(year)/kclassOwners/$(classId);
      return year == activeRosterYear() && exists(owner) && get(owner).data.email == myEmail();
    }
    function isYearKclassStaff(year) {
      let config = /databases/$(database)/documents/config/ksl;
      return isStaff() && year == activeRosterYear()
        && (ownsYearKclass(year, '1') || ownsYearKclass(year, '2') || ownsYearKclass(year, '3')
          || (exists(config) && myEmail() in get(config).data.get('teachers', [])));
    }
    match /rosterYears/{year}/kclassOwners/{classId} {
      allow get: if isAdmin() || (isStaff() && year == activeRosterYear());
      allow create, update: if isAdmin() && classId.matches('^[1-3]$')
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254;
    }
    match /rosterYears/{year}/kclassTimetables/{classId} {
      allow get: if isAdmin() || (isStaff() && year == activeRosterYear());
      allow create, update: if classId.matches('^[1-3]$') && (isAdmin() || (isStaff() && ownsYearKclass(year, classId)))
        && request.resource.data.keys().hasOnly(['slots', 'teacherName', 'instructorName'])
        && request.resource.data.slots is map && request.resource.data.slots.size() <= 80
        && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 30
        && request.resource.data.instructorName is string && request.resource.data.instructorName.size() <= 30;
    }
    match /rosterYears/{year}/kclassParticipation/{classId} {
      allow get: if isAdmin() || (isStaff() && ownsYearKclass(year, classId));
      allow create, update: if classId.matches('^[1-3]$')
        && (isAdmin() || (isStaff() && ownsYearKclass(year, classId)))
        && request.resource.data.keys().hasOnly(['slots'])
        && request.resource.data.slots is map && request.resource.data.slots.size() <= 30;
    }
    function validKclassStudentRecord(year, studentId, data) {
      let pupil = get(/databases/$(database)/documents/rosterYears/$(year)/migrantRoster/$(studentId)).data;
      return data.keys().hasOnly(['year', 'studentId', 'grade', 'cls', 'no', 'note'])
        && data.year == year && data.studentId == studentId
        && data.grade == pupil.grade && data.cls == pupil.cls && data.no == pupil.no
        && data.note is string && data.note.size() <= 2000;
    }
    match /rosterYears/{year}/kclassParticipation/{classId}/studentRecords/{studentId} {
      allow get: if isAdmin() || (isStaff() && ownsYearKclass(year, classId));
      allow create: if (isAdmin() || (isStaff() && ownsYearKclass(year, classId)))
        && validKclassStudentRecord(year, studentId, request.resource.data);
      allow update: if (isAdmin() || (isStaff() && ownsYearKclass(year, classId)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
    }
    function agreesWithMigrantMember(year, studentId, d) {
      let member = getAfter(yearMember(year, studentId)).data;
      return d.keys().hasOnly(['year', 'studentId', 'classId', 'grade', 'cls', 'no', 'type', 'country', 'name'])
        && d.year == year && d.studentId == studentId && d.classId == member.classId
        && d.grade == member.grade && d.cls == member.cls && d.no == member.no
        && d.type == member.mig && d.type in ['foreign', 'mid', 'domestic']
        && d.country == member.get('country', '') && d.name == member.displayName && member.status == 'enrolled';
    }
    match /rosterYears/{year}/migrantRoster/{studentId} {
      allow read: if isAdmin() || isYearKclassStaff(year) || isYearHomeroom(year, resource.data.classId);
      allow create, update: if isAdmin() || (isYearHomeroom(year, request.resource.data.classId)
        && agreesWithMigrantMember(year, studentId, request.resource.data));
      allow delete: if isAdmin() || (isYearHomeroom(year, getAfter(yearMember(year, studentId)).data.classId)
        && (getAfter(yearMember(year, studentId)).data.status != 'enrolled' || getAfter(yearMember(year, studentId)).data.get('mig', '') == ''));
    }
    function canWriteMigrantStat(year, studentId, deleting) {
      let member = getAfter(yearMember(year, studentId)).data;
      return isYearHomeroom(year, member.classId) && (deleting
        ? (member.status != 'enrolled' || member.get('mig', '') == '')
        : (member.status == 'enrolled' && member.mig in ['foreign', 'mid', 'domestic']
          && request.resource.data.type == member.mig && request.resource.data.country == member.get('country', '')));
    }
    match /rosterYears/{year}/migrantStats/{rowId} {
      allow read: if isAdmin() || (isStaff() && year == activeRosterYear());
      allow delete: if isAdmin() || canWriteMigrantStat(year, rowId, true);
      allow create, update: if request.resource.data.keys().hasOnly(['type', 'country'])
        && request.resource.data.type in ['foreign', 'mid', 'domestic']
        && request.resource.data.country is string && request.resource.data.country.size() <= 30
        && (isAdmin() || canWriteMigrantStat(year, rowId, false));
    }
    match /rosterTransferLinks/{id} {
      allow read, create, delete: if isAdmin();
    }
    match /rosterYears/{year}/records/{studentId} {
      allow read, create: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
